OPENAI_API_KEY=sk-your-key-here

# Alpaca broker credentials — sign up free at https://alpaca.markets
# Use PAPER keys to test, LIVE keys for real money
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
# Set to "live" for real money, "paper" for practice
ALPACA_MODE=paper

# YouTube Data API key — needed for the YouTube trader strategy feature
# Get a free key at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: comma-separated YouTube channel handles to follow by default.
# Used when you select "youtube" as the daemon watchlist source, so you
# don't have to retype them every run. Include or omit the leading @.
# Recommended starter channels (stocks + supported cryptos, frequent uploads, clear ticker calls):
#   MeetKevin       — daily uploads, specific stock picks, strong macro commentary
#   InvestAnswers   — data-driven, covers stocks AND supported cryptos (BTC, ETH)
#   TickerSymbolYOU — analytical deep-dives, easy for GPT to extract clear signals from
YOUTUBE_CHANNELS=MeetKevin,InvestAnswers,TickerSymbolYOU
