OPENAI_API_KEY=sk-your-key-here

# Alpaca broker credentials — sign up free at https://alpaca.markets
# Use PAPER keys to test, LIVE keys for real money
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
# Set to "live" for real money, "paper" for practice
ALPACA_MODE=paper

# YouTube Data API key — needed for the YouTube trader strategy feature
# Get a free key at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: comma-separated YouTube channel handles to follow by default.
# Used when you select "youtube" as the daemon watchlist source, so you
# don't have to retype them every run. Include or omit the leading @.
# Recommended starter channels (transcripts confirmed available, frequent uploads, clear ticker calls):
#   JosephCarlsonShow — dividend/growth stocks, very clear ticker breakdowns
#   ClearValueTax     — stocks + macro, plain-English analysis, transcripts always on
#   AndreiJikh        — stocks + crypto (BTC/ETH), high production, captions enabled
YOUTUBE_CHANNELS=JosephCarlsonShow,ClearValueTax,AndreiJikh

# Optional: path to a Netscape-format cookies.txt file exported from your browser.
# Required if YouTube starts blocking transcript requests from your IP.
# Export using the "Get cookies.txt LOCALLY" Chrome/Firefox extension (must be logged in to YouTube).
# YOUTUBE_COOKIES_FILE=cookies.txt

# Optional: NewsAPI.org key for richer Trump news coverage (100 free requests/day).
# Get a free key at https://newsapi.org/register
# Without this, the app falls back to Google News RSS (free, no key needed).
# NEWS_API_KEY=your-newsapi-key
